#include <iostream>
#include <string>

using namespace std;

class Cinema {
private:
    string name;
    string address;
    string website;

public:
    Cinema(string name, string address, string website)
        : name(name), address(address), website(website) {}

    void provideAddressInfo() {}

    void hostSession() {}

    string toString() const {
        return "Cinema{name='" + name + "', address='" + address + "', website='" + website + "'}";
    }
};

class Movie {
private:
    string title;
    int ageRestriction;
    int durationMinutes;
    string genre;

public:
    Movie(string title, int ageRestriction, int durationMinutes, string genre)
        : title(title), ageRestriction(ageRestriction), durationMinutes(durationMinutes), genre(genre) {}

    void provideImpressions() {}

    void applyAgeRules() {}

    string toString() const {
        return "Movie{title='" + title + "', ageRestriction=" + to_string(ageRestriction) +
               ", durationMinutes=" + to_string(durationMinutes) + ", genre='" + genre + "'}";
    }
};

class CinemaHall {
private:
    int hallNumber;
    string technology;
    int totalSeats;

public:
    CinemaHall(int hallNumber, string technology, int totalSeats)
        : hallNumber(hallNumber), technology(technology), totalSeats(totalSeats) {}

    void provideSeats() {}

    void displayMovieTechnology() {}

    string toString() const {
        return "CinemaHall{hallNumber=" + to_string(hallNumber) +
               ", technology='" + technology + "', totalSeats=" + to_string(totalSeats) + "}";
    }
};

class Session {
private:
    string showDate;
    string showTime;
    string format;
    string technology;
    double price;

public:
    Session(string showDate, string showTime, string format, string technology, double price)
        : showDate(showDate), showTime(showTime), format(format), technology(technology), price(price) {}

    void bindMovieToTime() {}

    string toString() const {
        return "Session{showDate='" + showDate + "', showTime='" + showTime +
               "', format='" + format + "', technology='" + technology +
               "', price=" + to_string(price) + "}";
    }
};

class Seat {
private:
    int rowNumber;
    int seatNumber;
    string category;

public:
    Seat(int rowNumber, int seatNumber, string category)
        : rowNumber(rowNumber), seatNumber(seatNumber), category(category) {}

    void accommodateViewer() {}

    string toString() const {
        return "Seat{rowNumber=" + to_string(rowNumber) +
               ", seatNumber=" + to_string(seatNumber) +
               ", category='" + category + "'}";
    }
};

class Order {
private:
    string orderNumber;
    string transactionDateTime;
    double amount;
    string paymentStatus;

public:
    Order(string orderNumber, string transactionDateTime, double amount, string paymentStatus)
        : orderNumber(orderNumber), transactionDateTime(transactionDateTime), amount(amount), paymentStatus(paymentStatus) {}

    void confirmPaymentFact() {}

    string toString() const {
        return "Order{orderNumber='" + orderNumber +
               "', transactionDateTime='" + transactionDateTime +
               "', amount=" + to_string(amount) +
               ", paymentStatus='" + paymentStatus + "'}";
    }
};

class Ticket {
private:
    string ticketNumber;
    string qrCode;
    double price;
    string status;

public:
    Ticket(string ticketNumber, string qrCode, double price, string status)
        : ticketNumber(ticketNumber), qrCode(qrCode), price(price), status(status) {}

    void confirmSeatPayment() {}

    void provideBarcodeForScan() {}

    string toString() const {
        return "Ticket{ticketNumber='" + ticketNumber +
               "', qrCode='" + qrCode +
               "', price=" + to_string(price) +
               ", status='" + status + "'}";
    }
};

class Viewer {
private:
    string fullName;
    string birthDate;
    string phoneNumber;
    string email;

public:
    Viewer(string fullName, string birthDate, string phoneNumber, string email)
        : fullName(fullName), birthDate(birthDate), phoneNumber(phoneNumber), email(email) {}

    void selectSeats() {}

    void payForOrder() {}

    string toString() const {
        return "Viewer{fullName='" + fullName +
               "', birthDate='" + birthDate +
               "', phoneNumber='" + phoneNumber +
               "', email='" + email + "'}";
    }
};

class Controller {
private:
    string employeeId;
    string fullName;

public:
    Controller(string employeeId, string fullName)
        : employeeId(employeeId), fullName(fullName) {}

    void scanQrCode() {}

    void checkDocuments() {}

    void redeemTicket() {}

    string toString() const {
        return "Controller{employeeId='" + employeeId +
               "', fullName='" + fullName + "'}";
    }
};

int main() {
    Cinema cinema("Multiplex", "вул. Хрещатик, 1", "www.multiplex.ua");
    Movie movie("Матриця", 16, 136, "Фантастика");
    CinemaHall hall(1, "IMAX", 150);
    Session session("2026-10-05", "19:00", "3D", "IMAX", 250.00);
    Seat seat(10, 15, "VIP");
    Order order("ORD-10023", "2026-10-04 15:30", 250.00, "Оплачено");
    Ticket ticket("T-998877", "QR-234SD", 250.00, "Активний");
    Viewer viewer("Іванов Іван Іванович", "1995-05-20", "+380501234567", "ivanov@email.com");
    Controller controller("C-001", "Петренко Петро Петрович");

    cout << cinema.toString() << endl;
    cout << movie.toString() << endl;
    cout << hall.toString() << endl;
    cout << session.toString() << endl;
    cout << seat.toString() << endl;
    cout << order.toString() << endl;
    cout << ticket.toString() << endl;
    cout << viewer.toString() << endl;
    cout << controller.toString() << endl;

    return 0;
}
